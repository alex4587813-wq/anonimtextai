<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="MainWindow"
    Title="Локальный анонимизатор"
    Width="1180"
    Height="820"
    MinWidth="960"
    MinHeight="700"
    WindowStartupLocation="CenterScreen"
    Background="#F4F5F7"
    FontFamily="Segoe UI"
    FontSize="14"
    UseLayoutRounding="True">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#0B6EF3" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#248A3D" />
        <SolidColorBrush x:Key="MutedBrush" Color="#667085" />
        <SolidColorBrush x:Key="BorderBrush" Color="#D8DCE3" />

        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>

        <Style x:Key="InputTextBox" TargetType="TextBox">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="BlueTagItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,8,6" />
            <Setter Property="Background" Value="#E8F1FF" />
            <Setter Property="BorderBrush" Value="#C9DDFB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="14">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#CFE2FF" />
                                <Setter Property="BorderBrush" Value="#75A7F5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OrangeTagItem" TargetType="ListBoxItem" BasedOn="{StaticResource BlueTagItem}">
            <Setter Property="Background" Value="#FFF0E2" />
            <Setter Property="BorderBrush" Value="#FFD8B5" />
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock
                FontSize="28"
                FontWeight="Bold"
                Text="Локальный анонимизатор" />
            <TextBlock
                Margin="0,6,0,0"
                Foreground="{StaticResource MutedBrush}"
                Text="Текст обрабатывается локально на вашем компьютере и не отправляется в интернет." />
        </StackPanel>

        <Grid
            x:Name="StatusPanel"
            Grid.Row="1"
            Margin="0,16,0,0"
            Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="StatusIcon"
                Grid.Column="0"
                Margin="0,0,8,0"
                FontSize="16"
                Foreground="{StaticResource SuccessBrush}"
                Text="●"
                VerticalAlignment="Center" />
            <TextBlock
                x:Name="StatusText"
                Grid.Column="1"
                FontWeight="SemiBold"
                Text=""
                VerticalAlignment="Center" />
            <TextBlock
                x:Name="StatusDetails"
                Grid.Column="2"
                Margin="18,0,0,0"
                Foreground="{StaticResource MutedBrush}"
                Text=""
                TextTrimming="CharacterEllipsis"
                VerticalAlignment="Center" />
        </Grid>

        <Border
            Grid.Row="2"
            Margin="0,18,0,0"
            Padding="20"
            Background="White"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="14">

            <Expander
                x:Name="RulesExpander"
                HorizontalContentAlignment="Stretch"
                IsExpanded="True">
                <Expander.Header>
                    <DockPanel LastChildFill="True">
                        <TextBlock
                            DockPanel.Dock="Left"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Text="Настройки правил анонимизации" />
                        <TextBlock
                            x:Name="RulesSummary"
                            DockPanel.Dock="Right"
                            Margin="24,2,0,0"
                            Foreground="{StaticResource MutedBrush}"
                            TextAlignment="Right" />
                    </DockPanel>
                </Expander.Header>

                <StackPanel Margin="0,18,0,0">
                    <TextBlock FontWeight="SemiBold" Text="Что обезличивать" />
                    <WrapPanel Margin="0,10,0,0">
                        <CheckBox x:Name="CategoryPerson" Margin="0,0,22,0" Content="ФИО" />
                        <CheckBox x:Name="CategoryCompany" Margin="0,0,22,0" Content="Организации" />
                        <CheckBox x:Name="CategoryPhone" Margin="0,0,22,0" Content="Телефоны" />
                        <CheckBox x:Name="CategoryEmail" Margin="0,0,22,0" Content="Email" />
                        <CheckBox x:Name="CategoryIP" Margin="0,0,22,0" Content="IP" />
                        <CheckBox x:Name="CategoryRequisite" Content="Реквизиты" />
                    </WrapPanel>

                    <Separator Margin="0,16,0,16" />

                    <TextBlock FontWeight="SemiBold" Text="Список исключений" />
                    <TextBlock
                        Margin="0,6,0,10"
                        Foreground="{StaticResource MutedBrush}"
                        Text="Если найденный фрагмент содержит указанное слово или фразу, он останется без изменений." />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="ExclusionInput"
                            Grid.Column="0"
                            Style="{StaticResource InputTextBox}"
                            ToolTip="Например: Платформикс" />
                        <Button
                            x:Name="AddExclusionButton"
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            Content="Добавить"
                            Style="{StaticResource BaseButton}" />
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ListBox
                            x:Name="ExclusionsList"
                            Grid.Column="0"
                            MinHeight="36"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemContainerStyle="{StaticResource BlueTagItem}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                        <Button
                            x:Name="RemoveExclusionButton"
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            Content="Удалить выбранное"
                            Style="{StaticResource BaseButton}" />
                    </Grid>

                    <Separator Margin="0,12,0,16" />

                    <TextBlock FontWeight="SemiBold" Text="Замена слов" />
                    <TextBlock
                        Margin="0,6,0,10"
                        Foreground="{StaticResource MutedBrush}"
                        Text="Эти слова и фразы заменяются всегда. Звёздочка в конце основы учитывает все окончания: Иванов* → Иванов, Иванову, Ивановым. Правило сильнее исключений; email, телефон, IP и реквизиты заменяются целиком."
                        TextWrapping="Wrap" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="MandatoryInput"
                            Grid.Column="0"
                            Style="{StaticResource InputTextBox}"
                            ToolTip="Слово или маска, например Иванов*" />
                        <Button
                            x:Name="AddMandatoryButton"
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            Content="Добавить"
                            Style="{StaticResource BaseButton}" />
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ListBox
                            x:Name="MandatoryList"
                            Grid.Column="0"
                            MinHeight="36"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemContainerStyle="{StaticResource OrangeTagItem}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                        <Button
                            x:Name="RemoveMandatoryButton"
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            Content="Удалить выбранное"
                            Style="{StaticResource BaseButton}" />
                    </Grid>
                </StackPanel>
            </Expander>
        </Border>

        <Grid Grid.Row="3" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Margin="0,0,0,8"
                    FontWeight="SemiBold"
                    Text="Исходный текст" />
                <TextBox
                    x:Name="SourceTextBox"
                    Grid.Row="1"
                    Padding="12"
                    AcceptsReturn="True"
                    AcceptsTab="True"
                    Background="White"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    SpellCheck.IsEnabled="False"
                    TextWrapping="Wrap" />
                <StackPanel
                    Grid.Row="2"
                    Margin="0,12,0,0"
                    Orientation="Horizontal">
                    <Button
                        x:Name="PasteButton"
                        Content="Вставить из буфера"
                        Style="{StaticResource BaseButton}" />
                    <Button
                        x:Name="ProcessButton"
                        Margin="10,0,0,0"
                        Content="Обезличить"
                        IsEnabled="False"
                        Style="{StaticResource PrimaryButton}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Margin="0,0,0,8"
                    FontWeight="SemiBold"
                    Text="Обезличенный текст" />
                <TextBox
                    x:Name="ResultTextBox"
                    Grid.Row="1"
                    Padding="12"
                    AcceptsReturn="True"
                    AcceptsTab="True"
                    Background="White"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    SpellCheck.IsEnabled="False"
                    TextWrapping="Wrap" />
                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Margin="0,0,12,0"
                        Foreground="{StaticResource MutedBrush}"
                        Text="Проверьте результат перед передачей во внешний сервис."
                        TextWrapping="Wrap"
                        VerticalAlignment="Center" />
                    <Button
                        x:Name="CopyButton"
                        Grid.Column="1"
                        Content="Скопировать"
                        IsEnabled="False"
                        Style="{StaticResource PrimaryButton}" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
